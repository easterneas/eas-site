---
import { MENU_ITEMS } from "@/constants/base";
import Logo from "../Logo.astro";
---
<nav class="order-2 sm:order-none fixed sm:inset-y-0 sm:left-0 sm:w-[120px] z-[100] bg-darkSecondary border-r-[1px] border-r-[#fc0]" id="main-nav">
  <ul class="nav__menu">
    {
      MENU_ITEMS.map((item, i) => {
        if (item.type === "logo")
          return (
            <li class="nav__menu-item w-auto sm:w-[120px] logo" style={`order: ${i}`}>
              <a class="logo-desktop" href={item.link}>
                <Logo size={90} />
              </a>
              <a class="logo-mobile" href={item.link}>
                <Logo size={32} />
              </a>
            </li>
          );

        return (
          <li
            class="nav__menu-item"
            style={`order: ${i}`}
            data-nav-path={item.link}
          >
            <a href={item.link}>{item.name}</a>
          </li>
        );
      })
    }
  </ul>
</nav>
