---
const { paginate } = Astro.props

const pagination = (p) => {
  const pages = new Array(p.lastPage).fill(true)

  const pageWithLink = (pageNumber) => (
    <a href={ `/${paginate.url.current.split('/')[1]}/${ pageNumber }` } class="pagination__page">
      { pageNumber }
    </a>
  )
  const currentPage = (pageNumber) => (<span class="pagination__page">{ pageNumber }</span>)
  const dots = () => (<span class="pagination__page">...</span>)
 
  if (p.lastPage > 1) {
    if (p.lastPage > 8) return pages.map((_, i) => {
      if (i + 1 === 1) return [
        p.currentPage === i + 1 ? currentPage(i + 1) : pageWithLink(i + 1),
        p.currentPage - 1 >= 3 && dots()
      ]

      if (i + 1 === p.lastPage) return [
        p.lastPage - p.currentPage >= 3 && dots(),
        p.currentPage === p.lastPage ? currentPage(i + 1) : pageWithLink(i + 1)
      ]

      if (p.currentPage - 1 === i + 1 || p.currentPage + 1 === i + 1) return pageWithLink(i + 1)
      if (i + 1 === p.currentPage) return currentPage(i + 1)

      return (<></>)
    })

    return pages.map((_, i) => ( p.currentPage === i + 1 ? currentPage(i + 1) : pageWithLink(i + 1) ))
  }

  return (<></>)
}
---

<div id="pagination">
  {
    paginate.currentPage !== 1 ?
    (<a class="pagination__prev" href={ paginate.url.prev }>Newer</a>) :
    (<span></span>)
  }
  <div id="pagination__pages">
    { pagination(paginate) }
  </div>
  {
    paginate.currentPage !== paginate.lastPage ?
    (<a class="pagination__next" href={ paginate.url.next }>Older</a>) :
    (<span></span>)
  }
</div>

<style>
#pagination {
  @apply grid;
  @apply grid-cols-3;
  @apply gap-4;
  grid-template-columns: 1fr 70% 1fr;
}

#pagination__pages {
  @apply flex;
  @apply justify-center;
  @apply gap-2;
}

#pagination :global(a, span) {
  @apply py-2;
  @apply px-4;
}

.pagination__next { @apply text-right; }
.pagination__prev { @apply text-left; }
</style>
