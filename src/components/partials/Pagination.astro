---
const { paginate } = Astro.props

const pagination = (p) => {
  const pages = new Array(p.lastPage).fill(true)

  const pageWithLink = (pageNumber) => (
    <a href={ `/${paginate.url.current.split('/')[1]}/${ pageNumber }` } class="pagination__page">
      { pageNumber }
    </a>
  )
  const currentPage = (pageNumber) => (<span class="pagination__page">{ pageNumber }</span>)
  const dots = () => (<span class="pagination__page">...</span>)
 
  if (p.lastPage > 1) {
    if (p.lastPage > 8) return pages.map((_, i) => {
      if (i + 1 === 1) return [
        p.currentPage === i + 1 ? currentPage(i + 1) : pageWithLink(i + 1),
        p.currentPage - 1 >= 3 && dots()
      ]

      if (i + 1 === p.lastPage) return [
        p.lastPage - p.currentPage >= 3 && dots(),
        p.currentPage === p.lastPage ? currentPage(i + 1) : pageWithLink(i + 1)
      ]

      if (p.currentPage - 1 === i + 1 || p.currentPage + 1 === i + 1) return pageWithLink(i + 1)
      if (i + 1 === p.currentPage) return currentPage(i + 1)

      return (<></>)
    })

    return pages.map((_, i) => ( p.currentPage === i + 1 ? currentPage(i + 1) : pageWithLink(i + 1) ))
  }

  return (<></>)
}
---

<div id="pagination">
  {
    paginate.currentPage !== 1 ?
    (<a id="pagination__prev" href={ paginate.url.prev }>Newer</a>) :
    (<span></span>)
  }
  <div id="pagination__pages">
    { pagination(paginate) }
  </div>
  {
    paginate.currentPage !== paginate.lastPage ?
    (<a id="pagination__next" href={ paginate.url.next }>Older</a>) :
    (<span></span>)
  }
</div>

<style lang="scss">
#pagination {
  @apply grid;
  // @apply grid-cols-3;
  // @apply gap-4;
  grid-template-columns: 1fr 70% 1fr;

  &__pages {
    @apply flex;
    @apply justify-center;
    @apply gap-1;
  }

  :global(a, span) {
    @apply py-2;
    @apply px-2;
  }

  a {
    width: 100%;
  }

  &__prev, &__next {
    @apply px-0;
  }
  &__next { @apply text-right; }
  &__prev { @apply text-left; }
}

a, :global(a.pagination__page) {
  @apply px-2;
  @apply py-1;
  position: relative;
  text-decoration: none;
  color: white;
  transition: color 120ms cubic-bezier(0.23, 1, 0.32, 1);
  z-index: 0;
  display: inline-block;

  &:hover,
  &:focus {
    color: #000000;

    &::before {
      transform: scaleY(1);
      background: var(--color-accent);
    }
  }

  &:visited {
    color: white;
    &:hover,
    &:focus {
      color: rgba(0, 0, 0, 1);
    }
  }

  &::before {
    transform-origin: bottom center;
    content: '';
    display: block;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    inset: 0;
    background: var(--color-accent);
    pointer-events: none;
    transform: scaleY(0.05);
    transition: transform 120ms cubic-bezier(0.23, 1, 0.32, 1), background 120ms cubic-bezier(0.23, 1, 0.32, 1);
    z-index: -1;
  }
}
</style>
