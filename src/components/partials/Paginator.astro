---
type Props = {
  paginate: StrapiMetadata;
};

const { paginate } = Astro.props;
const { pagination } = paginate

const paginator = {
  showPrev: pagination.page !== 1,
  showNext: pagination.page !== pagination.pageCount,
  pagesBeforeCurrent:
    pagination.page - 1 > 2 ? 2 : pagination.page - 1,
  pagesAfterCurrent:
    pagination.pageCount - pagination.page > 2
      ? 2
      : pagination.pageCount - pagination.page,
};
---

<div id="pagination">
  {
    pagination.page !== 1 ? (
      <button
        id="pagination__prev"
        onclick={"window.location.href = '../" + (pagination.page - 1) + "'"}
      >
        Newer
      </button>
    ) : (
      <span />
    )
  }
  <div id="pagination__pages" class="flex justify-center">
    {
      new Array(1 + paginator.pagesAfterCurrent + paginator.pagesBeforeCurrent)
        .fill("")
        .map((_, i) => pagination.page - paginator.pagesBeforeCurrent + i)
        .map((page) => {
          const pageUrlScript = `window.location.href = '../${page === 1 ? "" : page}'`;
          const pageSpan = <span class="pagination__page">{page}</span>;

          return page === pagination.page ? (
            <div class="active">{pageSpan}</div>
          ) : (
            <button onclick={pageUrlScript}>{pageSpan}</button>
          );
        })
    }
  </div>
  {
    pagination.page !== pagination.pageCount ? (
      <button
        id="pagination__next"
        onclick={"window.location.href = '../" + (pagination.page + 1) + "'"}
      >
        Older
      </button>
    ) : (
      <span />
    )
  }
</div>

<style lang="scss">
  #pagination {
    @apply grid;
    grid-template-columns: minmax(60px, 90px) 1fr minmax(60px, 90px);

    &__pages {
      @apply flex;
      @apply justify-center;
      @apply gap-[8px];
      @apply items-stretch;

      button,
      div {
        @apply flex;
        @apply p-2;
        @apply min-w-[50px] min-h-[50px];
        @apply items-center justify-center;
        @apply rounded;
        @apply text-[18px] font-[400];

        &:hover span {
          @apply text-black;
        }

        span {
          @apply text-[#fc0];
        }

        &.active {
          @apply bg-[#fc0];

          span {
            @apply text-black;
          }
        }
      }
    }

    &__prev,
    &__next {
      @apply border-0 border-b-[2px];
      @apply rounded-none;
      @apply text-white;

      &:hover {
        @apply text-black;
      }
    }
    &__next {
      @apply text-right;
    }
    &__prev {
      @apply text-left;
    }
  }
</style>
