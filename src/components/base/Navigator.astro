---

import Logo from '../Logo.astro'

const menu = [
  { name: "Home", link: "/", type: "logo" },
  { name: "About", link: "/about" },
  { name: "Portfolio", link: "/portfolios" },
  { name: "Blog", link: "/blog" },
  { name: "Contact", link: "/contact" },
]

const currentURL: string = Astro.request.canonicalURL.href

---

<div class="nav">
  <ul class="nav__menu">
    {
      menu.map((item, i) => {
        if (item.type === 'logo') return (
          <li class="nav__menu-item logo" style={`order: ${i}`}>
            <a class="logo-desktop" href={ item.link }>
              <Logo size={ 90 } />
            </a>
            <a class="logo-mobile" href={ item.link }>
              <Logo size={ 32 } />
            </a>
          </li>
        )

        return (
          <li
            class={
              [
                "nav__menu-item",
                currentURL.split('/').includes(item.link.split('/')[1] ? 'active' : '')
              ].join(' ')
            }
            style={`order: ${i}`}>
            <a href={ item.link }>
              { item.name }
            </a>
          </li>
        )
      })
    }
  </ul>
</div>
