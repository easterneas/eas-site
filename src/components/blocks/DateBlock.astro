---

export default interface Props {
  date: Date | string,
}

type FormattedDate = {
  year: string,
  month: string,
  day: string
}

function formatDate (date: Date): FormattedDate {
  return {
    year: date.toLocaleDateString('en-US', { year: 'numeric' }),
    month: date.toLocaleDateString('en-US', { month: 'short' }),
    day: date.toLocaleDateString('en-US', { day: 'numeric' }),
  }
}

const { date } = Astro.props
let formattedDate: FormattedDate

if (date) formattedDate = formatDate(new Date(date))

---

<div class="intro__date">
  <section class="date">
    <div class="date__block">
      <span class="date__month">{ formattedDate.month }</span>
      <span class="date__day">{ formattedDate.day }</span>
    </div>
    <div>
      <span class="date__year">{ formattedDate.year }</span>
    </div>
  </section>
</div>

<style lang="scss">

.intro__date {
  @apply grid;
  @apply grid-flow-col;

  margin: 0 !important;
  width: 100px !important;
  grid-template-rows: 100px 1fr;

  @media screen and (max-width: 600px) {
    width: 60px !important;
    grid-template-rows: 60px 1fr;
  }

  div {
    margin-top: 0;
  }

  div {
    @apply flex;
    @apply justify-center;
    @apply mt-2;

    span {
      margin: 0 !important;
      padding: 0 !important;
      @apply block;

      &.date__month {
        @apply uppercase;
      }

      &.date__day {
        @apply text-4xl;

        @media screen and (max-width: 600px) {
          @apply text-3xl;
        }
      }
    }
  }
  
  .date__block {
    height: 100px;
    margin: 0 !important;

    @apply bg-white;
    @apply text-gray-900;
    @apply flex;
    @apply justify-center;
    @apply items-center;
    @apply flex-col;

    @media screen and (max-width: 600px) {
      height: 60px;
    }
  }
}

</style>
