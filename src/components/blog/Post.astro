---
import Md from '../typography/Markdown.astro'
import Header from './partials/Header.astro'
import Tag from './partials/Tag.astro'

export interface Props {
  post: Object;
}

type Post = {
  key: string,
  title: string,
  tags: string[],
  updated: string,
  slug: string,
  lastUpdated: string,
  postContent: string,
  created: string,
  summary: string
}

const post: Post = Astro.props.post;
const { title: postTitle, created, tags, postContent } = post;

---

<Header title={ postTitle } date={ created } />

<div class="section__content">
  <Md content={ postContent } />
  <slot />
  {
    tags.length > 0
    && (
      <h5 class="tags">Listed under</h5>
    )
  }
  {
    tags.length > 0
    && (
      <div>
        {
          tags.map(tag => (
            <Tag name={ tag }/>
          ))
        }
      </div>
    )
  }
</div>
