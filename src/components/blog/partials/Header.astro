---
import DateBlock from '../../blocks/DateBlock.astro'

export default interface Props {
  title: string,
  date: Date | string,
}

const { date, title } = Astro.props

---
<section class="section__intro">
  {
    date !== null
    ? (<DateBlock date={ date } />)
    : ''
  }
  <section class={ [ 'intro__meta', date === null && 'full-width' ].join(' ') }>
    <h1 class="title">{ title }</h1>
  </section>
</section>

<style lang="scss">
.section__intro {
  @apply border-gray-800;
  margin-top: 2rem !important;
  padding-bottom: 2rem;

  @apply flex;
  @apply flex-grow-0;
  @apply flex-shrink-0;
  flex-basis: 100px;

  @media screen and (max-width: 600px) {
    flex-basis: 60px;
    margin-bottom: 3rem !important;
    padding-bottom: 3rem;
  }

  .intro__meta {
    @apply mb-4;
    @apply pl-4;
    @apply flex;
    @apply flex-col;
    @apply gap-2;

    margin: 0 !important;
    max-width: calc(100% - 100px);

    &.full-width{
      @apply pl-0;
      max-width: 100%;
    }

    @media screen and (max-width: 600px) {
      max-width: calc(100% - 60px);
    }

    * {
      margin: 0 !important;
    }

    .title {
      color: #ffcc00;
      line-height: 1.3;
    }
  }
}
</style>
