---
import Link from '../Link.astro'

export interface Props {
  post: Object;
}

function formatDate (date) {
  return new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
}

const { post } = Astro.props;
const { title, description, publishDate, tags, created, summary, lastUpdated } = post
const url = `/blog/post/${title}`
---
<article class="post-preview">
  <header>
    <Link text={ title } to={ url } size={ "title" } />
    { created ? (
      <h3 class="last-updated">
        Posted: {formatDate(created)}
      </h3>
    ) : '' }
  </header>

  <main>
    <p>{ description || summary || '(No summary provided)' }</p>
  </main>

  <Link text={ "Read more..." } type={ "button" } to={ url } />
</article>

<style lang="scss">
.content :global(main > * + *) {
  margin-top: 1rem;
}

.post-preview {
  @apply pb-8;
  @apply mb-8;
  @apply mt-4;
  border-bottom: 2px solid;
  @apply border-gray-800;

  main, header { @apply mb-4; }
}

header {
  @apply flex;
  @apply flex-col;
  @apply text-left;
  @apply items-start;
  @apply justify-center;
}

.title, .author, .last-updated { margin: 0; }

.last-updated, .author {
  @apply text-xs;
  color: var(--theme-text-lighter);

  font-weight: 400;
}

.title { font-weight: 700; margin-bottom: -12px; }

.post-preview > main { @apply mb-4; @apply text-sm; }

header > a::before {
  display: inline-block;
  margin-bottom: -12px;
  /* border-bottom: #cc8800 solid 8px !important; */
}

header > a {
  margin-bottom: 18px;
}

a.read-more {
  @apply text-xs;
  @apply px-2;
  @apply py-1;
}
</style>
