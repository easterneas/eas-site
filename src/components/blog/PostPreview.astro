---
import Link from '../Link.astro'
import DateBlock from '../blocks/DateBlock.astro'

export interface Props {
  post: Object;
}

const { post } = Astro.props;
const { title, description, publishDate, tags, created, summary, lastUpdated } = post
const url = `/blog/post/${title}`

---
<article class={ [ "post-preview", created === null && 'full-width' ].join(' ') }>
  {
    created !== null
    ? (<DateBlock date={ created } />)
    : ''
  }

  <main>
    <Link text={ title } to={ url } size={ "title" } />
    <p>{ description || summary || '(No summary provided)' }</p>
    <Link text={ "Read more..." } type={ "button" } to={ url } />
  </main>
</article>

<style lang="scss">
.content :global(main > * + *) {
  margin-top: 1rem;
}

.post-preview {
  margin-bottom: 2rem !important;
  padding-bottom: 2rem;
  border-bottom: 1px solid;
  @apply border-b-gray-600;

  @apply grid;
  grid-template-columns: 100px 1fr;

  &.full-width {
    grid-template-columns: 1fr;
  }

  @media screen and (max-width: 600px) {
    grid-template-columns: 60px 1fr;
    margin-bottom: 2rem !important;
    padding-bottom: 2rem;
  }

  main {
    @apply mb-4;
    @apply px-4;

    margin: 0 !important;

    &> p {
      @apply mb-4;
    }
  }
}
</style>
