---
import { twMerge } from "tailwind-merge";

const { to, text, size, type } = Astro.props;

interface Props {
  to: string;
  type?: "button" | "link";
  text: string;
  size?: "" | "title" | "large" | "small";
}

function parseClass(options = { size, type }) {
  const { size, type } = options;
  const res = [];

  res.push(sanitizeSize(size));
  res.push(setType(type));

  return res.join(" ");
}

function setType(type: Props["type"]) {
  return type || "button";
}

function sanitizeSize(size: Props["size"] = "") {
  if (!["title", "large", "small", ""].includes(size)) {
    size = "";
  }

  return size;
}
---

<a href={to} class={twMerge(parseClass(), "rounded-[4px] overflow-hidden")}>
  {text}
</a>

<style lang="scss">
  a {
    background-image: linear-gradient(to right, #fc0 50%, transparent 50%);
    background-size: 220% 100%;
    background-position: 100%;

    transition:
      background-position 250ms cubic-bezier(0.23, 1, 0.32, 1),
      color 250ms cubic-bezier(0.23, 1, 0.32, 1),
      padding 250ms cubic-bezier(0.23, 1, 0.32, 1);

    color: #fc0;
    text-decoration: none;

    &.link,
    &.button {
      position: relative;
      z-index: 0;
    }

    &.link {
      display: inline-block;

      color: #fc0;
      background-image: transparent;
      text-decoration: none;

      &:hover {
        color: #fff;
      }
    }

    &.button {
      color: #fc0;
      display: inline-block;

      @apply p-1;
      @apply text-sm;

      &:hover,
      &:focus {
        @apply text-gray-900;
        background-position: 0%;

        // @apply px-2;
      }

      &.large {
        @apply border-[1px] border-[#fc0];
        @apply px-4;
        @apply py-2;

        &:hover,
        &:focus {
          @apply text-gray-900;
          background-position: 0%;

          // @apply px-6;
        }
      }

      &.small {
        @apply px-1;
        @apply py-0.5;

        &:hover,
        &:focus {
          @apply text-gray-900;
          background-position: 0%;

          @apply px-6;
        }
      }
    }

    &.title {
      @apply font-title;
      @apply p-0;
      @apply font-[500];
      @apply text-2xl;
      display: block;
      background-image: linear-gradient(to right, #fc0 50%, transparent 50%);

      @media screen and (max-width: 640px) {
        @apply text-xl;
      }

      &:hover,
        &:focus {
          @apply text-gray-900;
          background-position: 0%;

          @apply pl-2;
        }
    }
  }
</style>
