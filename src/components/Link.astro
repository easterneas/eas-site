---
// 
const { to, text, size, type } = Astro.props

export default interface Props {
  to: string,
  type: string,
  text: string,
  size: string
}

function parseClass (options = { size, type }) {
  const { size, type } = options
  const res = []

  res.push(setSize(size))
  res.push(setType(type))

  return res.join(' ')
}

function setType (type) {
  type = type || ''

  switch (type) {
    case 'button':
      return 'button'
    default:
      return 'link'
  }
}

function setSize (size) {
  size = size || ''

  switch (size) {
    case 'title':
      return 'title'
    case 'large':
      return 'large'
    case 'small':
      return 'small'
    case '':
      return ''
    default:
      throw new Error(JSON.stringify({ msg: 'Invalid size', to, text, size }))
  }
}
---

<a href={ to } class={ parseClass() }>
  { size === 'title' ? (<h4>{ text }</h4>) : text }
</a>

<style lang="scss">

a {
  transition: background-position 250ms cubic-bezier(0.23, 1, 0.32, 1), color 250ms cubic-bezier(0.23, 1, 0.32, 1), padding 250ms cubic-bezier(0.23, 1, 0.32, 1);
  background: linear-gradient(to right, #fc0 50%, transparent 50%);
  background-size: 200% 100%;
  background-position: 100%;

  color: #fc0;
  text-decoration: none;

  &.link, &.button {
    position: relative;
    z-index: 0;
  }

  &.link {
    display: inline-block;

    color: #fc0;
    background: transparent;
    text-decoration: none;
    
    &:hover {
      color: #fff;
    }
  }

  &.button {
    color: #fc0;
    display: inline-block;

    @apply py-1;
    @apply text-sm;

    &:hover,
    &:focus {
      color: #000;
      background-position: 0%;

      @apply px-2;
    }
  }

  &.large {
    @apply px-4;
    @apply py-2;
  }

  &.small {
    @apply px-1;
    @apply py-0.5;

    @apply text-xs;
  }

  &.title {
    display: block;
    background: linear-gradient(to right, #fc0 50%, transparent 50%);
    background-size: 200% 100%;
    background-position: 100%;

    // margin: 0 !important;

    h4 { margin: 0 !important; }

    &:hover,
    &:focus {
      color: #000;
      background-position: 0%;

      @apply px-2;
    }
  }
}
</style>
