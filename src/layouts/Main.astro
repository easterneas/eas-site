---
import { Markdown } from 'astro/components';
import Head from '../components/base/Head.astro';
import Navigator from '../components/base/Navigator.astro';
import Footer from '../components/base/Footer.astro';

const {meta} = Astro.props;

const {title, description, publishDate, author, heroImage, permalink, alt} = meta;
---
<html lang={ meta?.lang || 'id' }>
  <head>
    <Head title={title} description={description} permalink={permalink} />
  </head>

  <body>
    <div class="layout">
      <Navigator />

      <div class="container">
        <slot />

        <Footer />
      </div>
    </div>
  </body>
</html>


<style>
  body {
    max-height: 100vh;
    overflow-y: hidden;
  }

  .layout {
    width: 100vw;
    display: grid;
    grid-template-columns: 125px 1fr;
    --gutter: 0.5rem;
    --doc-padding: 2rem;
  }

  article {
    margin: 0 auto;
  }

  header {
    width: 100%;
    height: 100%;
    background-color: var(--theme-bg-offset);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .container {
    padding-top: 4rem;
    padding-bottom: 8rem;
    height: 100vh;
    width: calc(100vw - 100px);
    overflow-y: auto;
    overflow-x: hidden;

    display: grid;
    grid-template-columns: calc(100vw - 100px);
  }

  .container :global(section) {
    margin: 0 auto;
    margin-top: 1rem;
    width: 50%;
  }

  .intro {
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 4px solid var(--theme-divider);
  }

  .intro > * {
    margin: 0;
  }

  .latest {
    font-size: 2.5rem;
    font-weight: 700;
  }

  :global(h1) { @apply mb-4; @apply text-4xl; }
  :global(h2) { @apply mb-4; @apply text-3xl; }
  :global(h3) { @apply mb-4; @apply text-2xl; }
  :global(h4) { @apply mb-4; @apply font-normal;  }
  :global(h5) { @apply mb-4; @apply text-sm; @apply font-normal; }
  :global(h6) { @apply mb-4; @apply text-xs; }
</style>
