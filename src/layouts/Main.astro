---
import Head from '../components/base/Head.astro';
import Navigator from '../components/base/Navigator.astro';
import Footer from '../components/base/Footer.astro';

type Meta = {
  title: string,
  description: string,
  publishDate: Date | string,
  author: string,
  heroImage: string,
  permalink: string,
  alt: string,
  lang: string
}

const pageMeta: Meta = Astro.props.meta
const contentMeta: Meta = Astro.props.content
const meta = {
  title      : pageMeta ? pageMeta.title : contentMeta.title,
  description: pageMeta ? pageMeta.description : contentMeta.description,
  publishDate: pageMeta ? pageMeta.publishDate : contentMeta.publishDate,
  author     : pageMeta ? pageMeta.author : contentMeta.author,
  heroImage  : pageMeta ? pageMeta.heroImage : contentMeta.heroImage,
  permalink  : pageMeta ? pageMeta.permalink : contentMeta.permalink,
  alt        : pageMeta ? pageMeta.alt : contentMeta.alt,
  lang       : pageMeta ? pageMeta.lang : contentMeta.lang
}

export default interface Props {
  meta: Meta,
  content: Object | null
}
---
<html lang={ meta.lang }>
  <head>
    <Head title={ meta.title } description={ meta.description } permalink={ meta.permalink } />
  </head>

  <body>
    <div class="layout">
      <Navigator />

      <div class="container">
        <slot />

        <Footer />
      </div>
    </div>
  </body>
</html>


<style lang="scss">
body {
  overflow-y: hidden;
}

.layout {
  display: grid;
  grid-template-columns: 130px 1fr;
  grid-template-rows: 1fr;
  width: 100%;
  height: 100%;

  :global(.nav) {
    order: 1;
  }

  @media screen and (max-width: 600px) {
    grid-template-columns: 1fr !important;
    grid-template-rows: 1fr 64px !important;
  }

  .container {
    height: 100vh;
    overflow-y: auto;
    overflow-x: hidden;

    order: 2;
    display: grid;

    :global(h1) {
      @apply mt-4;
      @apply mb-2;
      @apply text-4xl;
    }
    :global(h2) {
      @apply mt-4;
      @apply mb-2;
      @apply text-3xl;
    }
    :global(h3) {
      @apply mt-4;
      @apply mb-2;
      @apply text-2xl;
    }
    :global(h4) {
      @apply mt-4;
      @apply mb-2;
      @apply text-xl;

    }
    :global(h5) {
      @apply mt-4;
      @apply mb-2;
      @apply text-sm;
      @apply font-normal;
    }
    :global(h6) {
      @apply mt-4;
      @apply mb-2;
      @apply text-xs;
    }
    :global(p), :global(code), :global(pre), :global(li) {
      line-height: 1.3;
      @apply py-2;
    }

    @media screen and (max-width: 600px) {
      :global(h1) {
        @apply mt-4;
        @apply mb-2;
        @apply text-4xl;

      }
      :global(h2) {
        @apply mt-4;
        @apply mb-2;
        @apply text-2xl;

      }
      :global(h3) {
        @apply mt-4;
        @apply mb-2;
        @apply text-xl;

      }
      :global(h4) {
        @apply mt-4;
        @apply mb-2;
        @apply font-normal;

      }
      :global(h5) {
        @apply mt-4;
        @apply mb-2;
        @apply text-sm;
        @apply font-normal;

      }
      :global(h6) {
        @apply mt-4;
        @apply mb-2;
        @apply text-xs;

      }

      width: 100vw;
      display: block;
      height: calc(100vh - 64px);

      padding: 4rem 12.5vw 8rem 12.5vw;

      :global(footer) {
        display: none;
      }
    }

    &> :global(*) {
      width: calc(100vw - 130px);
      margin: 0 auto;
      @apply mt-4;
      // width: 100%;
      padding: 1rem calc(25vw - 50px);

      @media screen and (max-width: 600px) {
        padding: 1rem calc(5vw - 50px);
      }
    }

    :global(section) {
      @apply w-full;
    }
  }
}
</style>
