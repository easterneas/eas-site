---
// Component Imports

import Main from '../../layouts/Main.astro';
import Pagination from '../../components/partials/Pagination.astro';
import PostPreview from '../../components/blog/PostPreview.astro';

export async function getStaticPaths ({ paginate }) {
  // Data Fetching: List all Markdown posts in the repo.
  let allPosts = [
    ...Astro.fetchContent('./posts/*.md'),
    ...(await fetch(`http://localhost:10101`).then(res => res.json()))
      .map(post => ({ ...post, url: `/blog/post/${post.slug}` }))
  ];
  allPosts = allPosts.sort(
    (a, b) => new Date(b.publishDate || b.created) - new Date(a.publishDate || a.created)
  );

  // Full Astro Component Syntax:
  // https://docs.astro.build/core-concepts/astro-components/

  return paginate(allPosts, { pageSize: 5 })
}

const { page } = Astro.props
const { data: allPosts, ...pagination } = page

const meta = {
  title: "Blog",
  description: "Ini adalah jurnal gw, dan apa yang gw pelajari tentang tech dan coding.",
  permalink: "https://example.com/"
}

---

<Main meta={meta}>
  <section class="section__intro">
    <h1 class="latest">{meta.title}</h1>
    <p>{meta.description}</p>
  </section>

  <section class="section__content">
    {allPosts.map(p => <PostPreview post={p} />)}
    <hr />
    <Pagination paginate={ pagination } />
  </section>
</Main>

<style>
hr {
  @apply my-4;
  @apply border-gray-700;
}

.section__intro {
  @apply pb-24;
}

.section__content {
  @apply pb-16;
}
</style>
