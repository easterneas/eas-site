---
// Component Imports
import Main from '../../layouts/Main.astro';

import Pagination from '../../components/partials/Pagination.astro';
import PostPreview from '../../components/blog/PostPreview.astro';

import store from '../../store';

const { page } = Astro.props
const { data: allPosts, ...pagination } = page

const pageMeta = {
  title: `Blog`,
  description: `You're reading my <s>diary</s> digital, living journal of all things tech and programming.`,
}

export async function getStaticPaths ({ paginate, rss }) {
  const { posts: postCollection } = store
  const posts = await postCollection.getPosts()

  rss({
    title: 'Eas',
    description: 'Full stack developer. Mentor. Loves tinkering all things tech.',
    customData: '<language>en-us</language>',
    items: posts.map(post => {
      return {
        title: post.title,
        decription: post.summary,
        link: `/blog/post/${post.title}`,
        pubDate: post.created,
        customData: {
          summary: post.summary,
          tags: post.tags
        }
      }
    })
  })

  return paginate(posts, { pageSize: 10 })
}
---

<Main meta={ pageMeta }>
  <section>
    <h1 class="latest">{ pageMeta.title }</h1>
    <p>{ pageMeta.description }</p>
  </section>

  <section>
    { allPosts.map(p => <PostPreview post={ p } />) }

    <Pagination paginate={ pagination } />
  </section>
</Main>
