---
import PageHeader from "@/components/blocks/PageHeader.astro";
import MarkdownContent from "@/components/blocks/post-content/MarkdownContent";
import PostPreview from "@/components/blog/PostPreview.astro";
import Paginator from "@/components/partials/Paginator.astro";
import Base from "@/layouts/Base.astro";

import store from "@/store";

import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { PencilLineIcon } from "lucide-react";

export const getStaticPaths = (async ({ paginate }) => {
  const { posts: postCollection } = store;
  const response = await postCollection.getPosts().catch(() => null);

  if (!response) return paginate([]);

  const { data } = response;

  return paginate(data, { pageSize: 5 });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const {
  page: { data, ...paginator },
} = Astro.props as Props;

console.log({data, paginator})

const mdString = "I occassionally post here, with different kinds of topics that I usually encounter.";

const pageMeta = {
  title: "Blog",
  excerpt: mdString
};
---

<Base meta={pageMeta}>
  <div class="grid gap-8">
    <PageHeader Icon={PencilLineIcon}>
       Blog
    </PageHeader>

    <article>
      <MarkdownContent md={mdString} client:load />
    </article>

    <div class="mx-auto md:max-w-[800px] grid gap-8">
      {data.map((p) => <PostPreview post={p} />)}
    </div>

    <Paginator paginate={paginator} />
  </div>
</Base>
