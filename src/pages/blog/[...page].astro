---
import PageHeader from "@/components/blocks/PageHeader.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Base from "@/layouts/Base.astro";

import store from "@/store";

import { PencilLineIcon } from "lucide-react";

let posts: Post[] = [];

try {
  const response = await store.posts.getPosts();

  if (response) {
    posts = response.data;
  }
} catch (e) {
  console.error(e)
}

const mdString =
  "I occassionally post here, with different kinds of topics that I usually encounter.";

const pageMeta = {
  title: "Blog",
  excerpt: mdString,
};
---

<Base meta={pageMeta}>
  <div class="grid gap-8">
    <PageHeader Icon={PencilLineIcon}>Blog</PageHeader>

    <p>{mdString}</p>

    <div class="mx-auto md:max-w-[800px] grid gap-8">
      {posts.map((p) => <PostPreview post={p} />)}
    </div>
  </div>
</Base>
