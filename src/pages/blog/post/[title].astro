---
import { Markdown } from 'astro/components'

import store from '../../../store'

import Main from '../../../layouts/Main.astro'
import BlogPost from '../../../components/blog/Post.astro'
import { getData } from '../../../helpers/fetch'

export async function getStaticPaths ({ paginate, rss }) {
  const { posts: postCollection } = store
  const posts = (await postCollection.getPosts()).map(post => ({
    params: { title: post.title },
    props: { ...post }
  }))

  return posts
}

const { request, props: post } = Astro
const { params, canonicalURL } = request
const { postContent: content, lastUpdated, title } = post
---

<Main meta={ post }>
  <article>
    <BlogPost class="content" post={post}>
      <Markdown content={ content } />
      <pre>{ JSON.stringify(post, null, 2) }</pre>
    </BlogPost>
  </article>
</Main>

<style>
img {
  width: 100%
}
</style>
