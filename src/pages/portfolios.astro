---
import PageHeader from "@/components/blocks/PageHeader";
import MarkdownContent from "@/components/blocks/post-content/MarkdownContent";
import PortfolioSection from "@/components/sections/PortfolioSection";
import { CogIcon } from "lucide-react";
import Base from "../layouts/Base.astro";
import store from "../store";

const { portfolios: portfolioCollection } = store;

const { data: portfolios } = await portfolioCollection.getPortfolios();

const pageMeta = {
  title: "Portfolios",
  excerpt: "I love tinkering, so here's my work so far!",
};

const mdString = `
Here is the list of my portfolios.

Most of these are my self-projects, and
some of them are freely accessible through the link(s) provided.

Feel free to check things below!
`;
---

<Base meta={pageMeta}>
  <div class="grid gap-8">
    <PageHeader>
      <!-- this works like Icon={<PencilLineIcon />} in [p]react -->
      <CogIcon slot="Icon" />

      <!-- this is the actual "child" -->
       Portfolios
    </PageHeader>

    <MarkdownContent md={mdString} client:load />

    <div class="grid grid-cols-2 gap-4">
      <PortfolioSection portfolios={portfolios} client:load />
    </div>
  </div>
</Base>

<style lang="scss">
  section.markdown {
    :global(a) {
      position: relative;
      z-index: 0;
      color: white;

      transition: background-position 250ms cubic-bezier(0.23, 1, 0.32, 1);

      background: linear-gradient(to right, white, white 50%, #ffcc00 50%);
      background-size: 200% 100%;
      background-position: 100%;

      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;

      &:hover {
        background-position: 0 100%;
      }
    }
  }
</style>
