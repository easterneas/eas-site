---
// Component Imports
import Main from '../layouts/Main.astro'
import PostPreview from '../components/blog/PostPreview.astro'
import Link from '../components/Link.astro'

import store from '../store'

let posts = await store.posts.getPosts()

const meta = {
  title: "Example Blog",
  description: "Full stack developer. Mentor. Loves tinkering all things tech.",
  permalink: "https://example.com"
}

---
<Main meta={ meta }>
  <section>
    <h1>Oh, hi there! <u>Eas</u> here.</h1>
    <p>
      I'm Andreas, but you can just call me Eas.
    </p>
    <p>
      I'm a full-stack developer, heavily towards backend development. I love experimenting all things tech, and trying something new to solve problems.
    </p>
    <p>
      You can <Link text="learn more about me here" to="/about" />, in which I'll tell you more about me.
    </p>
  </section>
  <section>
    <h3>Portfolios</h3>
    <p>I love making apps, and here's the latest 3 projects:</p>
    <p>[==LATEST 3 PROJECTS==]</p>
    <p><Link text="My complete list of portfolios" type="button" to="/portfolios" /></p>
  </section>
  <section>
    <h3>Blog</h3>
    {
      posts.map(post => (
        <PostPreview post={post} />
      ))
    }
    <Link to="/blog" text="My other posts" type="button" size="large" />
  </section>
</Main>
