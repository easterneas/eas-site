---
// Component Imports
import Link from "../components/Link.astro";
import PostPreview from "../components/blog/PostPreview.astro";
import Base from "../layouts/Base.astro";

import Icon from "@/components/Icon";
import PageHeader from "@/components/blocks/PageHeader.astro";
import PortfolioSection from "@/components/sections/PortfolioSection";
import store from "../store";

const { portfolios: portfolioCollection } = store;

const { data: portfolios } = await portfolioCollection.getPortfolios();

const pageMeta = {
  excerpt: "Full stack developer. Mentor. Loves tinkering all things tech.",
  permalink: "https://example.com",
};

let posts: Post[] = [];
try {
  const response = await store.posts.getLatestPosts();

  if (response) {
    posts = response.data;
  }
} catch (e) {
  console.error(e);
}
---

<Base meta={pageMeta}>
  <div class="flex gap-4 font-title">
    <div
      class="bg-[#fc0] rounded-full p-3 rotate-[-20deg] text-black animate-wiggle"
    >
      <Icon name="Hand" size={36} />
    </div>

    <h1>
      Hi! I'm <span class="text-white">Eas</span>.
    </h1>
  </div>

  <p>
    A full-stack developer, who loves experimenting something new. <br />
    Also loves tinkering some IT stuffs. Homelabbing is one fun thing to do!
  </p>

  <PageHeader className="text-3xl border-none relative left-[-16px]">
    Latest Portfolios
  </PageHeader>

  <div class="grid gap-4 sm:grid-cols-3">
    <PortfolioSection portfolios={portfolios} limit={3} client:load />
  </div>

  <div class="flex">
    <Link
      to="/portfolios"
      text="Check out my other projects!"
      type="button"
      size="large"
    />
  </div>

  <PageHeader className="text-3xl border-none relative left-[-16px]">
    I also write things!
  </PageHeader>

  {posts.map((post) => <PostPreview post={post} />)}

  <div class="flex">
    <Link
      to="/blog"
      text="See my other posts here."
      type="button"
      size="large"
    />
  </div>
</Base>
