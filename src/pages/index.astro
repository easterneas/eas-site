---
// Component Imports
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/BlogHeader.astro';
import BlogPostPreview from '../components/BlogPostPreview.astro';


// Component Script:
// You can write any JavaScript/TypeScript that you'd like here.
// It will run during the build, but never in the browser.
// All variables are available to use in the HTML template below.
let title = 'Example Blog';
let description = 'The perfect starter for your perfect blog.';
let permalink = 'https://example.com/';

// Data Fetching: List all Markdown posts in the repo.
let allPosts = Astro.fetchContent('./posts/*.md');
allPosts = allPosts.sort((a, b) => new Date(b.publishDate) - new Date(a.publishDate));

---
<Main meta={ meta }>
  <section>
    <h1>Oh, hi there! <u>Eas</u> here.</h1>
    <p>
      I'm Andreas, but you can just call me Eas.
    </p>
    <p>
      I'm a full-stack developer, heavily towards backend development. I love experimenting all things tech, and trying something new to solve problems.
    </p>
    <p>
      You can <Link text="learn more about me here" to="/about" />, in which I'll tell you more about me.
    </p>
  </section>
  <section>
    <h3>Portfolios</h3>
    <p>I love making apps, and here's the latest 3 projects:</p>
    <p>[==LATEST 3 PROJECTS==]</p>
    <p><Link text="My complete list of portfolios" type="button" to="/portfolios" /></p>
  </section>
  <section>
    <h3>Blog</h3>
    {
      posts.map(post => (
        <PostPreview post={post} />
      ))
    }
    <Link to="/blog" text="My other posts" type="button" size="large" />
  </section>
</Main>
